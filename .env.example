# Default: https://cloud.karakeep.app
KARAKEEP_URL=
KARAKEEP_API_KEY=
# Set this to the same token as the Karakeep crawled webhook's Authorization token.
KARAKEEP_WEBHOOK_TOKEN=
# HTTP listen port (default 3000).
# PORT=3000
# Optional: browser profile for Weibo or Xiaohongshu pages requiring a login.
# WEBVIEW_PROFILE_DIR=./browser-profile
# Optional: run without a browser screenshot.
# SKIP_SCREENSHOT=1
# Optional: cookies from an authorized Weibo session when public requests hit visitor verification.
# WEIBO_COOKIE=
# Optional: save each generated Reader HTML as a standalone file.
# READER_OUTPUT_DIR=./reader-output
# Optional: direct Reader write when the Karakeep data directory is mounted in Docker.
# If this file does not exist, recap keeps the HTML archive and skips Reader write.
# KARAKEEP_DB_PATH=/mnt/.ix-apps/app_mounts/karakeep/data/db.db
